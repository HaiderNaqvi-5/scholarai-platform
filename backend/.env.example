APP_NAME=ScholarAI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://scholarai:password@localhost:5432/scholarai
SQL_ECHO=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

SECRET_KEY=change-me-in-production-min-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MVP_PRIMARY_COUNTRY=CA
MVP_SECONDARY_COUNTRY=US
MVP_FULBRIGHT_KEYWORD=fulbright
AUTO_SEED_DEMO_DATA=true  # dev only — leave UNSET in production; production assertion rejects True.
DEMO_STUDENT_EMAIL=student@example.com
DEMO_STUDENT_PASSWORD=strongpass1
DEMO_STUDENT_FULL_NAME=ScholarAI Demo Student
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=strongpass1
DEMO_ADMIN_FULL_NAME=ScholarAI Demo Admin

CORS_ORIGINS=["http://localhost:3000"]

# ── Firecrawl (capture path for scholarship ingestion; replaces Playwright) ──
# Cloud API key from https://www.firecrawl.dev/app/api-keys. Required in
# production; absence in dev/CI raises at first capture rather than silently
# falling back. Free tier: 1,000 credits/mo (300 used at every-10-day cadence).
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_SECONDS=60.0

# ── Email branding (sender display name only; provider keys below) ──
BRAND_DISPLAY_NAME=AidwiseAI
RESEND_TIMEOUT_SECONDS=10

# Public frontend origin used by transactional email CTA links.
FRONTEND_BASE_URL=https://aidwiseai.com

# ── Sentry (gated by SENTRY_DSN; unset = no init, app boots clean) ──
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.10
SENTRY_PROFILES_SAMPLE_RATE=0.10
SENTRY_ENVIRONMENT=development

# Auth provider — set to "clerk" after cutover
AUTH_PROVIDER=local

# Clerk (https://dashboard.clerk.com)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@grantpath.app
