NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Clerk (opt-in; leave blank to keep using local auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/feed
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
# Origin allowlist for clerkMiddleware authorizedParties (CSRF / subdomain-leak guard).
# Comma-separated; blank = unrestricted. Set in prod, e.g. https://aidwiseai.com
NEXT_PUBLIC_APP_ORIGIN=
# Clerk prod Frontend API origin for CSP (next.config.ts). Blank = dev hosts only
# (*.clerk.accounts.dev). Set in prod, e.g. https://clerk.aidwiseai.com
NEXT_PUBLIC_CLERK_FAPI=
